# ── Flask ────────────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_SECRET_KEY=change-me-to-a-long-random-string
FLASK_HOST=0.0.0.0
FLASK_PORT=5005
FLASK_DEBUG=false                   # flip to true locally only

# ── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/retailgex
# Zerodha/NIFTY market data only. Must be a different database from MONGO_URI.
ZERODHA_MONGO_URI=mongodb://localhost:27017/retailgex_zerodha

# ── Google OAuth  (Module 01) ─────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# In Google Cloud Console → OAuth client → Authorized redirect URIs, add the
# exact URL your browser uses (scheme + host + port must match):
#   http://127.0.0.1:5005/login/google/callback
# If you open the app as localhost instead, also add:
#   http://localhost:5005/login/google/callback
# Production: https://your-domain.com/login/google/callback

# ── Schwab API  (Module 02) ───────────────────────────────────────────────
SCHWAB_API_KEY=
SCHWAB_API_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
SCHWAB_TOKEN_PATH=.schwab_token.json  # auto-refreshed OAuth token cache

# ── Zerodha Kite Connect (NIFTY market data and margin estimates) ─────────
# Access tokens expire daily. Update locally and restart the web/scheduler
# processes; never paste credentials into chat or commit them.
ZERODHA_API_KEY=
ZERODHA_ACCESS_TOKEN=

# ── Stripe  (Module 06) ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Transactional email  (Module 01) ─────────────────────────────────────
# Verification + password-reset emails are sent via SendGrid's Web API
# (see docs/spec/07). Only these two vars are needed — the EMAIL_SMTP_* vars
# from the spec are not used when going the SendGrid-API route.
EMAIL_FROM=noreply@retailgex.csaini.org   # verified sender in SendGrid
SENDGRID_API_KEY=                          # blank in dev → emails are logged, not sent
ADMIN_CONTACT_EMAIL=hello@retailgex.csaini.org  # inbox for /contact form notifications

# ── Pricing  (Module 01 homepage) ─────────────────────────────────────────
PRO_PRICE='$29'                            # Pro tier price amount ("/ month" is static) — homepage / /api/pricing

# ── MCP server  (Module 11) ───────────────────────────────────────────────
# Public URL agents connect to — shown to users on the "API key created" page
# so they can copy/paste it straight into their MCP client config.
MCP_PUBLIC_URL=https://retailgex.csaini.org/mcp

# ── Twitter / X  (Module 08) ─────────────────────────────────────────────
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_BEARER_TOKEN=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
# The X developer app must have Read and write permission. Regenerate the
# access token pair after changing app permissions.

# ── Market hours & GEX formula  (Modules 02, 04) ────────────────────────
MARKET_OPEN=08:45                   # CT — scheduler gate; slightly before RTH open
MARKET_CLOSE=15:00                  # CT — scheduler gate
TIMEZONE=America/Chicago
CONTRACT_SIZE=100                   # options multiplier used in GEX formula

# ── Scheduler tuning  (Module 02, optional) ──────────────────────────────
SCHWAB_GEX_INTERVAL_MINUTES=5
CBOE_POLL_INTERVAL_MINUTES=15

# ── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/app.log               # leave blank to log to stdout
LOGS_PATH=logs/                     # directory for all log files
EXPORTS_PATH=exports/               # admin newsletter-export CSV landing dir

# ── Rate limiter storage (production: use Redis URL) ─────────────────────
RATELIMIT_STORAGE_URL=memory://
# RATELIMIT_STORAGE_URL=redis://localhost:6379/0

# ── Local LM Studio analysis ─────────────────────────────────────────────
# A host root or an explicit /v1 URL is accepted; both normalize to the same
# OpenAI-compatible chat-completions endpoint.
LM_STUDIO_BASE_URL=http://localhost:1234
LM_STUDIO_TEXT_MODEL=google/gemma-4-e4b
LM_STUDIO_VISION_MODEL=google/gemma-4-e4b
LM_STUDIO_TIMEOUT=240
# EOD source snapshot freshness guard. The normal 2:50 PM → 3:15 PM flow is
# about 25 minutes old; 120 also covers the workbook's 4:15–4:45 PM ET window.
SOCIAL_EOD_MAX_SNAPSHOT_AGE_MINUTES=120
SOCIAL_BRAND_NAME="GEX Intelligence"
SOCIAL_TWITTER_HANDLE="@gexintelligence"
SOCIAL_CHART_COLOR_POS="#2196F3"
SOCIAL_CHART_COLOR_NEG="#EF5350"
SOCIAL_CHART_COLOR_SPOT="#FFD700"
SOCIAL_CHART_BG="#0D1117"
SOCIAL_CHART_TEXT="#E0E0E0"
# EOD v3 image-only palette. Kept separate so EOW's legacy chart is unchanged.
SOCIAL_EOD_IMAGE_COLOR_POS="#22C55E"
SOCIAL_EOD_IMAGE_COLOR_NEG="#EF4444"
SOCIAL_EOD_IMAGE_COLOR_AMBER="#D29922"
SOCIAL_EOD_IMAGE_COLOR_ACCENT="#1D9BF0"
SOCIAL_EOD_IMAGE_SURFACE="#151A21"
SOCIAL_EOD_IMAGE_MUTED="#8B949E"

# ── Other LLM / AI analysis (optional/future) ───────────────────────────
# LLM_PROVIDER=ollama               # ollama | lm_studio
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3
# OLLAMA_TIMEOUT=60
# LM_STUDIO_MODEL=local-model
# LLM_MAX_ANALYSIS_CHARS=4000
