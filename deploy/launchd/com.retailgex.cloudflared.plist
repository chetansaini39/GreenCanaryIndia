<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.retailgex.cloudflared</string>

  <key>ProgramArguments</key>
  <array>
    <!-- Install cloudflared via: brew install cloudflare/cloudflare/cloudflared -->
    <string>/opt/homebrew/bin/cloudflared</string>
    <string>tunnel</string>
    <string>--config</string>
    <string>/Users/chetansaini/Documents/GitHub/RetailGex/deploy/cloudflare/config.yml</string>
    <string>run</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/chetansaini/Documents/GitHub/RetailGex/logs/cloudflared.stdout.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/chetansaini/Documents/GitHub/RetailGex/logs/cloudflared.stderr.log</string>

  <key>ThrottleInterval</key>
  <integer>10</integer>
</dict>
</plist>
